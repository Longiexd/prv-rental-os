{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prv-rental-os",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",

  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },

  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },

  "cache": {
    "enabled": false
  }
}