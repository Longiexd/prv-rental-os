{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prv-rental-os",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "cache": {
    "enabled": false
  },
  "env": {
    "staging": {
      "name": "prv-rental-os-staging",
      "routes": [
        {
          "pattern": "staging.rental-os.klynx.net",
          "custom_domain": true
        }
      ],
      "vars": {
        "APP_ENV": "staging",
        "NEXT_PUBLIC_API_URL": "https://api-staging.rental-os.klynx.net"
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "workers_dev": false,
      "preview_urls": false
    },
    "production": {
      "name": "prv-rental-os",
      "routes": [
        {
          "pattern": "rental-os.klynx.net",
          "custom_domain": true
        }
      ],
      "vars": {
        "APP_ENV": "production",
        "NEXT_PUBLIC_API_URL": "https://api.rental-os.klynx.net"
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "workers_dev": false,
      "preview_urls": false
    }
  }
}

